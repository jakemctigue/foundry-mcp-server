{
  "name": "@foundry-mcp/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "foundry-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test test-e2e",
    "test": "vitest run test",
    "test:e2e": "vitest run test-e2e"
  },
  "dependencies": {
    "@foundry-mcp/foundry-module": "workspace:*",
    "@foundry-mcp/host": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
